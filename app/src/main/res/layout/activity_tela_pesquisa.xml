<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#180202"
    android:backgroundTint="#1F0202"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".telaPesquisa">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:srcCompat="@drawable/mensagem" />

    <!-- RadioGroup agrupando corretamente os botões de opção -->
    <RadioGroup
        android:id="@+id/radioOpcoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/tituloOpcao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Por Título"
            android:textColor="#EFEBEB"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/grupoOpcao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Por Grupo"
            android:textColor="#E4DBDB"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RadioGroup>

    <EditText
        android:id="@+id/pesqEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Digite aqui, em branco para todos"
        android:inputType="text"
        android:textColor="#EFEAEA"
        android:textColorHint="#F2EBEB" />

    <!-- Spinner posicionado após a caixa de texto e antes dos botões -->
    <Spinner
        android:id="@+id/spinnerGrupos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="#E7E0E0"
        android:backgroundTint="#EDE9E9"
        android:padding="8dp" />

    <TextView
        android:id="@+id/btnPesquisar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#0AA810"
        android:layout_gravity="center"
        android:onClick="pesquisar"
        android:text="@string/pesquisar"
        android:textColor="#F0EEEE"
        android:fontFamily="cursive"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_gravity="center"
        android:backgroundTint="#4D4949"
        android:onClick="telaInicial"
        android:text="@string/inicio"
        android:textColor="#EDE3E3"
        android:fontFamily="cursive"
        android:textSize="30sp"
        android:textStyle="bold" />

</LinearLayout>