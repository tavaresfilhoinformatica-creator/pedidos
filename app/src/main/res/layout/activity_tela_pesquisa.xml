<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".telaPesquisa">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:srcCompat="@drawable/garcon" />

    <!-- RadioGroup agrupando corretamente os botões de opção -->
    <RadioGroup
        android:id="@+id/radioOpcoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/tituloOpcao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Por Título"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/grupoOpcao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Por Grupo"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RadioGroup>

    <EditText
        android:id="@+id/pesqEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Digite aqui, em branco para todos"
        android:inputType="text" />

    <!-- Spinner posicionado após a caixa de texto e antes dos botões -->
    <Spinner
        android:id="@+id/spinnerGrupos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnPesquisar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#0AA810"
        android:onClick="pesquisar"
        android:text="Pesquisar"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#4D4949"
        android:onClick="telaInicial"
        android:text="Voltar"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>