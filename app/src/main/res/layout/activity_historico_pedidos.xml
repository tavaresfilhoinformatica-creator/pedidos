<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1B0101">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Histórico de Pedidos"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Mensagem de aviso caso não existam pedidos -->
    <TextView
        android:id="@+id/txtSemPedidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum pedido encontrado."
        android:textColor="#CCCCCC"
        android:gravity="center"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoricoPedidos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_historico_pedido" />

</LinearLayout>