<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100101"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp"
      android:scrollbarStyle="outsideInset"
      android:scrollbars="vertical">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="cursive"
        android:text="@string/meusdados"
        android:textColor="#E6DDDD"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Campo Nome -->
    <EditText
        android:id="@+id/etNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Nome Completo"
        android:inputType="textPersonName"
        android:textColor="#F8F4F4"
        android:textColorHint="#E2D7D7" />

    <!-- Campo CPF -->
    <EditText
        android:id="@+id/etCpf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="CPF"
        android:inputType="number"
        android:maxLength="11"
        android:textColor="#F2EBEB"
        android:textColorHint="#E9E4E4" />

    <!-- Campo Telefone -->
    <EditText
        android:id="@+id/etTelefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Telefone"
        android:inputType="phone"
        android:maxLength="11"
        android:textColor="#E6DCDC"
        android:textColorHint="#E6DFDF" />

    <!-- Campo CEP -->
    <EditText
        android:id="@+id/etCep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="CEP"
        android:inputType="number"
        android:maxLength="8"
        android:textColor="#E9E1E1"
        android:textColorHint="#E0D6D6" />

    <!-- Campo Endereço -->
    <EditText
        android:id="@+id/etEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Endereço (Rua, Nº)"
        android:inputType="textPostalAddress"
        android:textColor="#F4F2F2"
        android:textColorHint="#E2D4D4" />

    <!-- Campo Bairro -->
    <EditText
        android:id="@+id/etBairro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Bairro"
        android:inputType="text"
        android:textColor="#F0E9E9"
        android:textColorHint="#E6D7D7" />

    <!-- Campo Municipio -->
    <EditText
        android:id="@+id/etMunicipio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Município"
        android:inputType="text"
        android:textColor="#EFE7E7"
        android:textColorHint="#EFE4E4" />

    <!-- Campo Estado -->
    <EditText
        android:id="@+id/etEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Estado (UF)"
        android:inputType="text"
        android:maxLength="2"
        android:scrollbars="vertical"
        android:textColor="#EBE4E4"
        android:textColorHint="#F0E9E9" />

    <!-- Botão Salvar -->
    <TextView
        android:id="@+id/btnSalvar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#044907"
        android:layout_gravity="center"
        android:fontFamily="cursive"
        android:onClick="salvarDados"
        android:text="@string/salvar"
        android:textColor="#E7EDE6E6"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Botão Meus Pedidos -->
    <TextView
        android:id="@+id/btnMeusPedidos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1976D2"
        android:fontFamily="cursive"
        android:text="@string/meuspedidos"
        android:textColor="#E9FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Botão Voltar -->
    <TextView
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#757575"
        android:fontFamily="cursive"
        android:onClick="telaInicial"
        android:text="@string/voltar"
        android:textColor="#E4FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

  </LinearLayout>
</ScrollView>