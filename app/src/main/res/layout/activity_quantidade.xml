<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B0101"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Nome do Produto Selecionado -->
    <TextView
        android:id="@+id/txtNomeProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="#F8EFEF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Preço Unitário -->
    <TextView
        android:id="@+id/txtPrecoProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#EFE7E7"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Seletor de Quantidade (- 1 +) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMenos"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="#ED0D0D"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtQuantidade"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:text="1"
            android:textColor="#EFE7E7"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMais"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="#0FD517"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- BOTÃO: Confirmar Item -->
    <Button
        android:id="@+id/btnConfirmarItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#388E3C"
        android:text="Confirmar Item"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- BOTÃO: Excluir do Carrinho -->
    <Button
        android:id="@+id/btnExcluirItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#D32F2F"
        android:text="Excluir do Carrinho"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- BOTÃO: Continuar Comprando (Volta sem salvar) -->
    <Button
        android:id="@+id/btnContinuarComprando"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Continuar Comprando"
        android:textColor="#EDE4E4" />

    <!-- BOTÃO: Ver Meu Carrinho -->
    <Button
        android:id="@+id/btnFinalizarPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#120101"
        android:text="Meu Carrinho"
        android:textColor="#E9D7D7" />

</LinearLayout>