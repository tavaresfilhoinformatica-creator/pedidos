{
  "headers": [
    {
      "source": "/furabolo.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=furabolo.apk"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/furabolo.apk",
      "destination": "/public/furabolo.apk"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
